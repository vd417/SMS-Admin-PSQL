# Backend API base URL (optional; defaults to the production API).
# For a local Sms.Api: VITE_API_BASE=http://localhost:5162/v1
VITE_API_BASE=https://api.sms.catretech.me/v1

# Google Maps — used by the Live bus tracking map.
# Create a key in Google Cloud (enable "Maps JavaScript API") and a Map ID
# (Maps > Map Management) for Advanced Markers. Put real values in .env.local.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
